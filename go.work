// Development workspace: stitches the four modules so a cross-module edit
// builds immediately. `make check` also builds and tests each module ALONE
// (GOWORK=off) — the workspace is convenience, never the contract. It uses
// only modules in this repo; the gridwell api arrives from the module proxy
// like any other dependency.
go 1.26.5

use (
	./fs
	./gitlab
	./guest
	./proc
)
